# Copy to .env. Staging = Supabase Cloud (synthetic data only). Never put production values here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
APP_ENV=development
# The API connects as its own role, never as the owner. Locally the runner sets this
# password on the role from this URL; on Supabase the owner sets it once and this
# becomes postgresql://mcwellness_api.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
API_DATABASE_URL=postgresql://mcwellness_api:mcwellness_api@localhost:5432/postgres
# Token verification: SUPABASE_URL gives the issuer; set SUPABASE_JWKS_URL (projects on
# signing keys) or SUPABASE_JWT_SECRET (legacy projects, and local development).
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=local-development-only-not-a-real-secret-0123456789
# The master key behind the Emirates ID fingerprint and seal: 64 hexadecimal characters.
# This value is refused anywhere but development; generate one per environment with
# openssl rand -hex 32 and keep it in the deployment's secret store.
IDENTITY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# The browser's sign-in. Set both for a Supabase project (staging, production); leave both
# empty on a laptop and the API's development door offers the seeded people instead.
# VITE_SUPABASE_URL must name the same project as SUPABASE_URL above: the API trusts that
# project's tokens and names its origin in the content security policy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Rate limits per minute (defaults shown), and how many reverse proxies to trust
# for X-Forwarded-For (0: none, the socket address is the caller).
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_ACTOR_PER_MINUTE=600
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=20
RATE_LIMIT_DEV_DOOR_PER_MINUTE=30
TRUSTED_PROXY_HOPS=0
# SERVE_APP=true makes the API serve the built app from dist/ (staging, production).
SERVE_APP=
