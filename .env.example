# Copy to .env. Staging = Supabase Cloud (synthetic data only). Never put production values here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
APP_ENV=development
# The API connects as its own role, never as the owner. Locally the runner sets this
# password on the role from this URL; on Supabase the owner sets it once and this
# becomes postgresql://mcwellness_api.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
API_DATABASE_URL=postgresql://mcwellness_api:mcwellness_api@localhost:5432/postgres
# Token verification: SUPABASE_URL gives the issuer; set SUPABASE_JWKS_URL (projects on
# signing keys) or SUPABASE_JWT_SECRET (legacy projects, and local development).
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=local-development-only-not-a-real-secret-0123456789
# The master key behind the Emirates ID fingerprint and seal: 64 hexadecimal characters.
# This value is refused anywhere but development; generate one per environment with
# openssl rand -hex 32 and keep it in the deployment's secret store.
IDENTITY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# The browser's sign-in. Set both for a Supabase project (staging, production); leave both
# empty on a laptop and the API's development door offers the seeded people instead.
# VITE_SUPABASE_URL must name the same project as SUPABASE_URL above: the API trusts that
# project's tokens and names its origin in the content security policy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where documents live (docs/SEAMS.md): "local" is a folder on this machine and the
# default on a laptop and in the tests; "supabase" is the private `documents` bucket.
# Outside development the choice is explicit or the API refuses to start.
# STORAGE_DIR must sit outside the repository or be git-ignored inside it, as the
# default .storage/ is: a practice's documents must never reach a commit.
# SUPABASE_STORAGE_KEY is its own variable with no fallback - SUPABASE_SERVICE_ROLE_KEY
# above is never stood in for it - and it is the service key, never the anon key the
# browser holds. Leave it empty here.
STORAGE_PROVIDER=local
STORAGE_DIR=.storage
SUPABASE_STORAGE_KEY=
# The portal's sign-ins (docs/SPEC/client-portal.md section 8). Its own variable, with
# no fallback to SUPABASE_SERVICE_ROLE_KEY and never the anon key; blank means absent,
# and a deployment without it keeps the in-memory fallback, so everything else starts
# and only the invitation door answers 503. On a laptop and in the tests the fallback is
# what runs whatever is set here. Leave it empty.
SUPABASE_AUTH_ADMIN_KEY=
# Rate limits per minute (defaults shown), and how many reverse proxies to trust
# for X-Forwarded-For (0: none, the socket address is the caller).
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_ACTOR_PER_MINUTE=600
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=20
RATE_LIMIT_DEV_DOOR_PER_MINUTE=30
# The portal's invitation door, which answers somebody who is not signed in.
RATE_LIMIT_INVITE_DOOR_PER_MINUTE=10
TRUSTED_PROXY_HOPS=0
# Where this deployment's app answers, as the practice hands the address out. The
# portal's invitation link is built on it (docs/SPEC/client-portal.md section 7) and
# never on the request's own Host header, which is whatever the caller typed. Unset
# on a laptop, where the request's own loopback origin stands in; unset anywhere else
# and the invitation route issues nothing and says so.
PUBLIC_APP_URL=
# SERVE_APP=true makes the API serve the built app from dist/ (staging, production).
SERVE_APP=
# One worktree per parallel session, each with its own database, API and web port
# (docs/PARALLEL-SESSIONS.md and the table in docs/SPEC/OWNERSHIP.md). The trunk uses
# the defaults below; a worktree's own .env moves all three and sets COMPOSE_PROJECT_NAME
# so its database container is its own.
DB_PORT=5432
PORT=3000
WEB_PORT=5173
COMPOSE_PROJECT_NAME=mcwellness
