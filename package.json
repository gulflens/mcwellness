{
  "name": "mcwellness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx app/api/server.ts",
    "start": "SERVE_APP=true node --env-file-if-exists=.env --import tsx app/api/server.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:migrations": "node scripts/audit-migrations.mjs",
    "worktree:add": "node scripts/worktree.mjs add",
    "worktree:remove": "node scripts/worktree.mjs remove",
    "audit:deps": "node scripts/audit-deps.mjs",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p .",
    "verify": "pnpm -s format:check && pnpm -s lint && pnpm -s typecheck && pnpm -s audit:secrets && pnpm -s audit:migrations && pnpm -s test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env --import tsx db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx db/reset.ts",
    "seed": "node --env-file-if-exists=.env --import tsx db/seed/index.ts",
    "seed:sql": "node --env-file-if-exists=.env --import tsx db/seed/render-cli.ts",
    "seed:wording": "node --env-file-if-exists=.env --import tsx scripts/upload-consent-wording.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
